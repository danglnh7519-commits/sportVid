# Copy to .env. Never commit real keys. Azure Speech is optional when using recorded voice.
VOICE_PROVIDER=auto
# auto: Azure when a key is configured, otherwise Edge Read Aloud via node-edge-tts.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=vi-VN-NamMinhNeural
# Optional API key with Google Drive API enabled for paginated folder discovery.
GOOGLE_DRIVE_API_KEY=
# Optional installed Chromium path. Windows Google Chrome is detected automatically.
CHROME_PATH=
